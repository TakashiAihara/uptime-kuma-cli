{
  "name": "uptime-kuma-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for Uptime Kuma 1.23 over its Socket.IO API",
  "bin": {
    "uptime-kuma-cli": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun scripts/build.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "test:integration": "bun scripts/integration.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "socket.io-client": "4"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "socket.io": "4"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
